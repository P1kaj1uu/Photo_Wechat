{
  "pages": [
    "pages/login/login",
    "pages/home/home",
    "pages/publish/publish",
    "pages/message/message",
    "pages/my/my"
  ],
  "subpackages": [
    {
      "root": "packageA",
      "name": "分包A",
      "pages": [
        "pages/myInfo/myInfo",
        "pages/myPurchase/myPurchase",
        "pages/myPublish/myPublish",
        "pages/goodDetail/goodDetail"
      ],
      "independent": true
    },
    {
      "root": "packageB",
      "name": "分包B",
      "pages": [
        "pages/systemMessage/systemMessage",
        "pages/chatMessage/chatMessage"
      ],
      "independent": true
    }
  ],
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "校园约拍",
    "navigationBarBackgroundColor": "#ffffff"
  },
  "tabBar": {
    "borderStyle": "black",
    "color": "#808080",
    "selectedColor": "#333333",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "images/home-static.png",
        "selectedIconPath": "images/home-active.png"
      },
      {
        "pagePath": "pages/publish/publish",
        "text": "发布",
        "iconPath": "images/publish-static.png",
        "selectedIconPath": "images/publish-active.png"
      },
      {
        "pagePath": "pages/message/message",
        "text": "消息",
        "iconPath": "images/message-static.png",
        "selectedIconPath": "images/message-active.png"
      },
      {
        "pagePath": "pages/my/my",
        "text": "我的",
        "iconPath": "images/my-static.png",
        "selectedIconPath": "images/my-active.png"
      }
    ]
  },
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "van-field": "@vant/weapp/field/index",
    "van-popup": "@vant/weapp/popup/index",
    "van-button": "@vant/weapp/button/index",
    "van-cell": "@vant/weapp/cell/index",
    "van-cell-group": "@vant/weapp/cell-group/index",
    "van-nav-bar": "@vant/weapp/nav-bar/index"
  }
}